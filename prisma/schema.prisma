// Prisma schema for Rapid Payment Gateway integration
// Docs: https://rapidgateway.pk/resources/payment-webhooks-guide

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL is required for Vercel/serverless deploys — SQLite's file-based
  // storage does not survive across serverless function invocations.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// NextAuth.js models (Prisma Adapter — required for Google + Facebook OAuth)
// Spec: https://next-auth.js.org/adapters/prisma
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // OAuth provider that created this account (google | facebook)
  provider      String?
  // Role: "user" (default) or "admin". Admins can access /admin and see all orders.
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  orders   Order[]
}

model Account {
  // Compound id is required by NextAuth's Prisma adapter.
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// App models
// ---------------------------------------------------------------------------

/// A product in the storefront catalog.
model Product {
  id          String   @id @default(cuid())
  /// URL-safe slug, e.g. "raast-qr-sticker". Unique.
  slug        String   @unique
  name        String
  description String
  /// Price in paisa (1 PKR = 100 paisa). Avoid float drift.
  priceMinor  Int
  currency    String   @default("PKR")
  /// Optional image URL (external). Empty = use placeholder.
  imageUrl    String?
  /// Optional category for filtering, e.g. "Stickers", "Digital", "Services".
  category    String?
  /// Inventory count. 0 = out of stock. null = unlimited (digital goods).
  stock       Int?
  /// Soft delete + visibility toggle.
  active      Boolean  @default(true)
  /// Show on homepage as featured.
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@index([active, featured])
  @@index([category])
  @@index([slug])
}

/// A single checkout order created on our side before redirecting to Rapid.
model Order {
  // Our internal order id (also used as merchantTransactionId sent to Rapid)
  id String @id @default(cuid())

  // The merchantTransactionId we send to Rapid. We prefix the internal id so
  // it is human-readable in the Rapid portal ("ORDER-<short>").
  merchantTransactionId String @unique

  // PKR by default; store as integer minor units (paisa) to avoid float bugs.
  // 100.00 PKR = 10000 paisa.
  amountMinor  Int
  currency     String  @default("PKR")

  // Customer details captured at checkout time.
  customerEmail   String
  customerName    String?
  customerPhone   String?
  description     String?

  // Lifecycle: PENDING -> SUCCESS | FAILED | REFUNDED
  status      String  @default("PENDING")
  environment String  @default("SANDBOX")

  // Set by Rapid on success/failure.
  gatewayTxnRef String?

  // Raw redirect query string Rapid sent back to our return URL (for debugging).
  redirectPayload String?

  // The authenticated user who created this order.
  userId String?
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Items in this order (snapshot of product name + price at purchase time).
  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webhookEvents WebhookEvent[]

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

/// Snapshot of a product at the time of purchase.
/// We store name + price here (not just productId) so that if a product is
/// later edited or deleted, the historical order still shows the correct
/// name and price the customer paid.
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Snapshot of product name at purchase time.
  name      String
  /// Snapshot of unit price at purchase time (paisa).
  priceMinor Int
  quantity  Int
  /// Snapshot of image URL at purchase time (optional).
  imageUrl  String?

  @@index([orderId])
  @@index([productId])
}

/// Every webhook delivery we successfully verify is persisted here.
/// The same eventId may arrive more than once — we de-dupe on it.
model WebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique // X-RapidGateway-Delivery / payload.eventId
  eventType String             // transaction.completed, refund.failed, ...
  rawBody   String             // exact bytes we received (for audit)
  signature String             // X-RapidGateway-Signature we verified against
  timestamp String             // X-RapidGateway-Timestamp

  // Optional link to the order this event pertains to (matched by merchantTransactionId).
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  processedAt DateTime @default(now())

  @@index([eventType])
  @@index([processedAt])
}
