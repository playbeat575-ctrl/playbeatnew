# ---------------------------------------------------------------------------
# Rapid Gateway environment variables
#
# Copy this file to `.env` (local dev) or set the same vars in Vercel
# Project Settings → Environment Variables (production).
#
# ⚠️  NEVER commit your real .env. It is gitignored by default.
# ---------------------------------------------------------------------------

# "sandbox" or "live". Sandbox never charges real cards.
# For production on Vercel, set this to "live".
RAPID_GATEWAY_ENV=sandbox

# Your merchant ID — a number shown in the Rapid portal top-right.
RAPID_GATEWAY_MERCHANT_ID=375

# Server-to-server API key for outbound calls (create session, query txn).
RAPID_GATEWAY_API_KEY=replace-with-your-real-api-key

# Webhook HMAC-SHA256 signing salt — from Developers → Webhooks → your webhook.
# Used ONLY to verify inbound webhook signatures.
RAPID_GATEWAY_WEBHOOK_SALT=replace-with-your-real-webhook-salt

# Base URL of the Rapid API. Sandbox and live use different hosts.
# Confirm the exact host from your portal — these are the common defaults.
RAPID_GATEWAY_BASE_URL=https://sandbox-api.rapidgateway.pk
# RAPID_GATEWAY_BASE_URL=https://api.rapidgateway.pk   # for live

# Public base URL of THIS app. Used to build the redirect URL Rapid sends the
# customer back to, and the webhook URL you'll register in the Rapid portal.
# In production this is your real Vercel domain, e.g. https://your-app.vercel.app
RAPID_GATEWAY_APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database — PostgreSQL (required for Vercel/serverless)
#
# Vercel Postgres:    postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Neon:               postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Supabase:           postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
#
# For local dev you can still use SQLite by changing prisma/schema.prisma
# provider back to "sqlite" and using: DATABASE_URL=file:./dev.db
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

